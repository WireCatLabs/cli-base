#!/usr/bin/env sh
# Publishes the version in package.json and tags it. Run on a clean `main`. When npm already has that
# version, or a higher one, it lands the next free version on `main` through a pull request and publishes that: an
# unpublished section is renamed to it, while a published one keeps its heading and the new version gets the
# Unreleased section, or a new one. The `changes/` fragments are collected into the version's section, which may then
# need a higher level. An Unreleased section left above the dated, unpublished version is folded into it first,
# through a pull request too, after the last release's section is put back to its tag.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local   # publishes from this machine: the keyring entry NPM_KEYRING_ACCOUNT names, else npm's login
#   bin/release --major   # also allows a new major version; without it, a version that raises the major stops
#
# The npm token is never printed — not on success, not in an error.
set -eu

cd "$(dirname "$0")/.."
self=$(git hash-object bin/release)
# The fold and land() fast-forward main, and sh reads this file as it goes: a newer bin/release would run half old,
# half new. Run the new one from the start instead: the second run finds the fold and the raise already on main.
rerun_if_changed() {
  [ "$(git hash-object bin/release)" != "$self" ] || return 0
  [ -z "${WIRECAT_RELEASE_RERUN:-}" ] || { echo "bin/release changed again while releasing — run it again" >&2; exit 1; }
  echo "bin/release changed on main — running the new one"
  export WIRECAT_RELEASE_RERUN=1
  exec ./bin/release "$@"
}

mode=ci
major=""
for flag in "$@"; do
  case "$flag" in
    --local) mode=local ;;
    --major) major=1 ;;
    *) echo "usage: bin/release [--local] [--major]" >&2; exit 2 ;;
  esac
done

git fetch -q origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell keeps running the file it read before the merge; max-cli published with a stale copy.
[ "$(git rev-parse HEAD)" = "$before" ] || exec ./bin/release "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }
# One release at a time per package on this machine: two sessions published at once on 2026-10-08.
. ./config/wirecat/release-lock.sh
wirecat_release_lock

version=$(node -p 'require("./package.json").version')
# `npm view` rather than the registry document, which a CDN serves stale for minutes.
published() {
  npm view "@wirecat/cli-base@$version" version --prefer-online >/dev/null 2>&1
}
dev() { node dist/dev/bin.js "$@"; }
# A pull request checked before the last release and merged after it put its entry in that release's section;
# restore moves it to Unreleased, so the fold below brings it into this version.
restored=$(pnpm build >/dev/null && dev changelog restore --land)
[ -z "$restored" ] || echo "$restored"
rerun_if_changed "$@"
# A session that merges after the version was dated, but before it was published, adds Unreleased above it.
# --land folds on a fresh main through its own pull request, and folds again once if main moves under it.
if ! published; then
  folded=$(pnpm build >/dev/null && dev changelog fold --land --version "$version")
  [ -z "$folded" ] || echo "$folded"
fi
rerun_if_changed "$@"

# main takes changes only through a pull request (the repository's ruleset).
land() {
  branch=$1 title=$2 body=$3
  git switch -q -c "$branch"
  git commit -q -am "$title" -m "$body"
  git push -q -u origin "$branch" || { echo "could not push $branch — nothing is published" >&2; exit 1; }
  git switch -q main
  pr=$(gh pr create --base main --head "$branch" --title "$title" --body "$body")
  # Checks register a few seconds after the pull request; --watch with none exits at once.
  for _ in $(seq 30); do
    [ "$(gh pr checks "$pr" --required --json name --jq length 2>/dev/null || echo 0)" -gt 0 ] && break
    sleep 2
  done
  gh pr checks "$pr" --watch --required --fail-fast >/dev/null ||
    { echo "checks failed on $pr — nothing is published" >&2; exit 1; }
  for _ in $(seq 180); do
    state=$(gh pr view "$pr" --json mergeStateStatus -q .mergeStateStatus)
    case "$state" in CLEAN|HAS_HOOKS|UNSTABLE) break ;; esac
    [ "$(gh pr view "$pr" --json state -q .state)" = CLOSED ] && { echo "$pr was closed without merging" >&2; exit 1; }
    sleep 10
  done
  case "$state" in CLEAN|HAS_HOOKS|UNSTABLE) ;; *) echo "$pr is $state after 30 minutes" >&2; exit 1 ;; esac
  gh pr merge "$pr" --squash --delete-branch --subject "$title (#${pr##*/})" ||
    { echo "$pr did not merge (main moved under it?) — close it and run bin/release again" >&2; exit 1; }
  git fetch -q origin
  git merge -q --ff-only origin/main
}

# Raises the version from $1 to $2 in package.json and the CHANGELOG heading. With $3 set, npm has $1: its section
# stays as published, and the unreleased one becomes $2 (#706). Both files are checked before either is written.
renumber() {
  node -e 'const fs = require("fs"); const [o, n, taken] = process.argv.slice(1)
    const swap = (file, text, from, to) => {
      if (!text.includes(from)) throw new Error(`${file} has no ${JSON.stringify(from.trim())} to raise ${o} to ${n}`)
      return text.replace(from, to)
    }
    const today = new Date().toLocaleDateString("en-GB").replaceAll("/", ".")
    const pkg = swap("package.json", fs.readFileSync("package.json", "utf8"), `"version": "${o}"`, `"version": "${n}"`)
    const log = fs.readFileSync("CHANGELOG.md", "utf8")
    const top = log.match(/^## .*$/m)?.[0] ?? ""
    const heading = `\n## ${n} — ${today}\n`
    let next
    if (taken && log.includes("\n## Unreleased\n")) next = swap("CHANGELOG.md", log, "\n## Unreleased\n", heading)
    // With only changes/ fragments there is no Unreleased section: the new version gets an empty one they fill.
    else if (taken) next = swap("CHANGELOG.md", log, "\n## ", `${heading}\n## `)
    else if (top.startsWith(`## ${o} — `)) next = swap("CHANGELOG.md", log, `\n## ${o} — `, `\n## ${n} — `)
    else throw new Error(`CHANGELOG.md top section is ${JSON.stringify(top)} — date it as ${o} first`)
    fs.writeFileSync("package.json", pkg)
    fs.writeFileSync("CHANGELOG.md", next)' "$1" "$2" "$3"
}

# A major breaks every caller of the stable API, so it ships only when the owner chose to (WC-REL-7). Checked before
# a version lands on main, so a refused major leaves main as it was.
allow_major() {
  if [ "${1%%.*}" != "${latest%%.*}" ] && [ -n "$latest" ] && [ -z "$major" ]; then
    echo "$1 raises the major version over npm's $latest — run bin/release --major if that is meant" >&2
    exit 1
  fi
}

# An Unreleased section with at least one line under it, before the next version's heading.
unreleased() {
  awk '/^## /{if (u) exit; u = ($0 == "## Unreleased"); next} u && NF {found = 1; exit} END {exit !found}' CHANGELOG.md
}
fragments() {
  find changes -maxdepth 1 -type f -name '*.md' ! -name README.md 2>/dev/null | wc -l
}
# The tree was clean at the start; a refusal before a version lands puts it back, so the next run is not refused.
undo() {
  git checkout -q HEAD -- .
}
# land() pulls main, which may bring fragments merged while its pull request waited: they belong to this version.
rerun_if_fragments() {
  [ "$(fragments)" -gt 0 ] || return 0
  echo "changes/ fragments merged while releasing — running bin/release again to collect them"
  exec ./bin/release "$@"
}

# Two sessions preparing the same number is normal; the second takes the next free one (2026-09-29). A version npm
# has starts again from its patch: the entries after it, not its own section, decide the level below.
latest=$(npm view @wirecat/cli-base version --prefer-online 2>/dev/null || true)
versions=$(npm view @wirecat/cli-base versions --json --prefer-online 2>/dev/null || true)
taken=""
want=$version
if published; then
  taken=1
  case "$version" in
    *-*) ;;
    *) want=$(node -p 'const [a, b, c] = process.argv[1].split(".").map(Number); `${a}.${b}.${c + 1}`' "$version") ;;
  esac
fi
next=$(node scripts/next-version.mjs "$want" "$latest" "$versions")
count=$(fragments)
if [ "$next" != "$version" ]; then
  if [ -n "$taken" ]; then why="$version is already on npm"; else why="$version is not above npm's latest $latest"; fi
  if [ -n "$taken" ] && [ "$count" -eq 0 ] && ! unreleased; then
    echo "$why and nothing is unreleased — add an Unreleased section or a changes/ fragment first" >&2
    exit 1
  fi
  trap undo EXIT
  renumber "$version" "$next" "$taken"
  [ "$count" -eq 0 ] || dev changelog fragments --collect "$next"
  # The section, with the fragments now in it, may need more than the number npm left free: an Added is a minor.
  levelled=$(dev changelog level --next "$next")
  if [ "$levelled" != "$next" ]; then
    levelled=$(node scripts/next-version.mjs "$levelled" "$latest" "$versions")
    renumber "$next" "$levelled" ""
    next=$levelled
  fi
  allow_major "$next"
  trap - EXIT
  echo "$why — publishing $next instead"
  land "release/$next" "chore(release): $next" "bin/release: $why. Only the number changes, to the level the changelog
needs: package.json, the CHANGELOG heading, and the changes/ fragments collected under it."
  rerun_if_changed "$@"
  version=$next
  rerun_if_fragments "$@"
elif [ "$count" -gt 0 ] && [ -z "$taken" ]; then
  # The version was dated by hand; fragments merged since then still belong to it, and may need a higher level.
  allow_major "$version"
  trap undo EXIT
  dev changelog fragments --collect "$version"
  levelled=$(dev changelog level --next "$version")
  if [ "$levelled" != "$version" ]; then
    levelled=$(node scripts/next-version.mjs "$levelled" "$latest" "$versions")
    renumber "$version" "$levelled" ""
    allow_major "$levelled"
    trap - EXIT
    echo "the changes/ fragments need $levelled — publishing it instead of $version"
    land "release/$levelled" "chore(release): $levelled" \
      "bin/release: the changes/ fragments merged since $version was dated need $levelled, collected into its section."
    version=$levelled
  else
    trap - EXIT
    land "release/$version-changes" "chore(changelog): collect changes/ into $version" \
      "bin/release: the changes/ fragments merged since $version was dated, collected into its section."
  fi
  rerun_if_changed "$@"
  rerun_if_fragments "$@"
fi
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi
allow_major "$version"
top=$(sed -n '/^## /{p;q;}' CHANGELOG.md)
case "$top" in
  "## $version — "*) ;;
  *) echo "CHANGELOG.md's top section is \"$top\" — date it as $version first" >&2; exit 1 ;;
esac

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  echo "published @wirecat/cli-base@$version"
  exit 0
fi

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm lint && pnpm typecheck && pnpm test
pnpm build && pnpm smoke:bun

# No default account: one person's account name does not belong in a shared script. Unset, pnpm uses your npm login.
if [ -n "${NPM_KEYRING_ACCOUNT:-}" ]; then
  NPM_TOKEN=$(secret-tool lookup service npm account "$NPM_KEYRING_ACCOUNT" 2>/dev/null) && [ -n "$NPM_TOKEN" ] ||
    { echo "no npm token in the keyring for service npm, account $NPM_KEYRING_ACCOUNT" >&2; exit 1; }
  export NPM_TOKEN
fi

echo "== publishing $version =="
case "$version" in *-*) tag=next ;; *) tag=latest ;; esac
pnpm publish --access public --no-git-checks --tag "$tag"

echo "== waiting for npm to show $version (up to three minutes) =="
seen=""
for _ in $(seq 36); do
  if published; then seen=1; break; fi
  sleep 5
done
[ -n "$seen" ] || { echo "npm does not show $version after three minutes — not tagging; tag v$version by hand once it does" >&2; exit 1; }

echo "== tag v$version =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
echo "published @wirecat/cli-base@$version"
