{
  "name": "@wirecat/cli-base",
  "version": "1.2.0",
  "description": "The parts every command line tool needs: output modes, terminal rendering, error model, exit codes, credentials, clocks",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/cli-base.git"
  },
  "homepage": "https://github.com/WireCatLabs/cli-base#readme",
  "bugs": {
    "url": "https://github.com/WireCatLabs/cli-base/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.28.8",
  "files": [
    "dist",
    "config",
    "constants.json",
    "docs/standards",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "bin": {
    "cli-dev": "dist/bundle/cli-dev.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/bundle/testing.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "default": "./dist/bundle/testing-setup.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/bundle/http.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/bundle/commands.js"
    },
    "./completion": {
      "types": "./dist/completion/index.d.ts",
      "default": "./dist/bundle/completion.js"
    },
    "./update": {
      "types": "./dist/update/index.d.ts",
      "default": "./dist/bundle/update.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/bundle/codegen.js"
    },
    "./codegen/runtime": {
      "types": "./dist/codegen/runtime.d.ts",
      "default": "./dist/bundle/codegen-runtime.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/bundle/release.js"
    },
    "./skill": {
      "types": "./dist/skill/index.d.ts",
      "default": "./dist/bundle/skill.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/bundle/mcp.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/bundle/query.js"
    },
    "./standards": {
      "types": "./dist/standards/index.d.ts",
      "default": "./dist/bundle/standards.js"
    },
    "./standards/tables": {
      "types": "./dist/standards/tables.d.ts",
      "default": "./dist/bundle/standards-tables.js"
    },
    "./wcat": {
      "types": "./dist/wcat/index.d.ts",
      "default": "./dist/bundle/wcat.js"
    },
    "./wcat/start": {
      "types": "./dist/wcat/start.d.ts",
      "default": "./dist/bundle/wcat-start.js"
    },
    "./wcat/manifest": {
      "types": "./dist/wcat/manifest.d.ts",
      "default": "./dist/bundle/wcat-manifest.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/bundle/dev.js"
    },
    "./preload": {
      "types": "./dist/bundle/preload.d.ts",
      "default": "./dist/bundle/preload.js"
    },
    "./biome": "./config/biome.base.json",
    "./tsconfig.base.json": "./config/tsconfig.base.json",
    "./tsconfig.test.json": "./config/tsconfig.test.json",
    "./tsconfig.scripts.json": "./config/tsconfig.scripts.json",
    "./lefthook.yml": "./config/lefthook.yml",
    "./cspell": "./config/cspell.json",
    "./package.json": "./package.json"
  },
  "wirecat": {
    "stable": [
      ".",
      "./http",
      "./commands",
      "./completion",
      "./update",
      "./codegen/runtime",
      "./skill",
      "./mcp",
      "./query",
      "./standards",
      "./standards/tables",
      "./wcat/start",
      "./wcat/manifest"
    ]
  },
  "scripts": {
    "build": "tsc --build --force && node scripts/bundle-dist.ts",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "pnpm build && node dist/dev/bin.js docs-check --ids CLI,MAX,OPS,CORE,SPEC,DOC && node scripts/standards-ids.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; pnpm build >/dev/null && node dist/dev/bin.js slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:images": "node docs/images/src/render.ts",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md \"docs/standards/**/*.md\"",
    "ci:quick": "pnpm typecheck"
  },
  "dependencies": {
    "@valibot/to-json-schema": "1.8.0",
    "cli-table3": "^0.6.5",
    "cross-spawn": "7.0.6",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "@scalar/openapi-upgrader": "0.4.6",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "commander": "^15.0.0",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "rolldown": "1.2.15",
    "swagger-converter": "2.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@scalar/openapi-upgrader": "^0.4.6",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "rolldown": "^1.2.15",
    "swagger-converter": "^2.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@scalar/openapi-upgrader": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "swagger-converter": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
